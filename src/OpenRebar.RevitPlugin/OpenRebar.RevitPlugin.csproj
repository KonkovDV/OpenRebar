<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenRebar.RevitPlugin</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRebar.Domain\OpenRebar.Domain.csproj" />
    <ProjectReference Include="..\OpenRebar.Application\OpenRebar.Application.csproj" />
    <ProjectReference Include="..\OpenRebar.Infrastructure\OpenRebar.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="addin\RevitNet8\OpenRebar.addin" Link="OpenRebar.addin" CopyToOutputDirectory="PreserveNewest" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
    <None Include="addin\RevitNet10\OpenRebar.addin" Link="OpenRebar.addin" CopyToOutputDirectory="PreserveNewest" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <!-- Revit API NuGet — uncomment when Revit SDK available -->
    <!-- <PackageReference Include="Autodesk.Revit.SDK" Version="2025.0.0" /> -->
  </ItemGroup>

</Project>
