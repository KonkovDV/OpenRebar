{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://OpenRebar-reinforcement.local/contracts/company-profile.schema.json",
  "title": "OpenRebar company profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "steelClass", "concreteClass", "additional", "ends", "laps", "positions", "schedule", "supply", "smoothing", "verification", "safety", "legend"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "extends": { "type": ["string", "null"] },
    "example": { "type": "boolean" },
    "description": { "type": ["string", "null"] },
    "steelClass": { "type": "string", "minLength": 1 },
    "concreteClass": { "type": "string", "minLength": 1 },
    "additional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diametersMm", "spacingMode"],
      "properties": {
        "diametersMm": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "spacingMode": { "type": "string", "enum": ["interleave", "explicit", "s/2"] },
        "maxDiameterCount": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "ends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition"],
      "properties": {
        "condition": { "type": "string", "enum": ["NeedsHook", "Straight", "Hook", "LBar", "UBar"] }
      }
    },
    "laps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jointRatioMax", "couplers"],
      "properties": {
        "jointRatioMax": { "type": "number", "minimum": 0, "maximum": 1 },
        "couplers": { "type": "boolean" }
      }
    },
    "positions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includeLayerInKey"],
      "properties": { "includeLayerInKey": { "type": "boolean" } }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["culture"],
      "properties": { "culture": { "type": "string", "enum": ["ru", "invariant"] } }
    },
    "supply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplierName", "stockLengthsMm", "specialLengths", "offcuts"],
      "properties": {
        "supplierName": { "type": "string", "minLength": 1 },
        "stockLengthsMm": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "specialLengths": { "type": "boolean" },
        "offcuts": { "type": "boolean" }
      }
    },
    "smoothing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": { "allowed": { "type": "boolean" } }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["underCoverageRatio"],
      "properties": { "underCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor", "anchorageLengthFactor", "lapLengthFactor"],
      "properties": {
        "factor": { "type": "number", "minimum": 1 },
        "anchorageLengthFactor": { "type": "number", "minimum": 1 },
        "lapLengthFactor": { "type": "number", "minimum": 1 },
        "maxSpacingMm": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 400 }
      }
    },
    "legend": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["color", "diameterMm", "spacingMm"],
        "properties": {
          "color": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
          "diameterMm": { "type": "integer", "minimum": 1 },
          "spacingMm": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
